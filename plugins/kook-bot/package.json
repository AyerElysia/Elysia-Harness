{
  "name": "@elysia/kook-bot",
  "description": "KOOK channel plugin: Gateway socket and REST text send for send_text",
  "version": "0.2.1-rc.3",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src/**/*.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@elysia/conscious-mind": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@elysia/conscious-mind": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
