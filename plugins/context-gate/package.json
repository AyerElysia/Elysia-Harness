{
  "name": "@elysia/context-gate",
  "description": "Elysia/Context-Gate (爱莉希雅·门扉): provider context kinds, generic event envelopes, per-session subscriptions and queues, one merged snapshot per step, the per-session time engine, and the merged custom-event rule engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.map",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "tsdown",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-util-time": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../dsh/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../dsh/vendor/schemastery",
    "@deepseek-ai/dsh-agent": "link:../../dsh/packages/core/agent",
    "@deepseek-ai/dsh-agent-loop-testkit": "link:../../dsh/packages/test-support/agent-loop-testkit",
    "@deepseek-ai/dsh-client-connection": "link:../../dsh/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../../dsh/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../dsh/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../dsh/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../dsh/packages/client/ui-slots",
    "@deepseek-ai/dsh-llm": "link:../../dsh/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../dsh/packages/core/session",
    "@deepseek-ai/dsh-tools": "link:../../dsh/packages/core/tools",
    "@deepseek-ai/dsh-typert-protocol": "link:../../dsh/packages/typert/protocol",
    "@deepseek-ai/dsh-util-time": "link:../../dsh/packages/util/time",
    "@deepseek-ai/dsh-subagent": "link:../../dsh/packages/subagent/subagent",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}